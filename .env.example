# Postgres (Neon recommended) — enable pgvector in SQL editor:
# CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set DATABASE_SSL=0 only for local Postgres without TLS

# Hedera seller (receives x402 payments)
SELLER_ACCOUNT_ID=0.0.xxxxx

# Hedera buyer (pays for fact details via client/MCP)
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=0x...
HEDERA_KEY_TYPE=ecdsa
HEDERA_NETWORK=hedera:testnet

# x402 facilitator (Blocky402 testnet — no API key required)
FACILITATOR_URL=https://api.testnet.blocky402.com

# Pricing
FACT_PRICE_HBAR=0.1

# Optional creator account shown in UI
DEFAULT_CREATOR_ACCOUNT_ID=0.0.xxxxx

PORT=3002
SERVER_URL=http://localhost:3002
ALLOW_RESET=1

# Gemini agent (Interactions API — gemini-3.1-flash-lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=high

# Browser wallet (HashPack via Reown AppKit) — free at https://dashboard.reown.com
REOWN_PROJECT_ID=

# Pinata IPFS photo uploads — https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
PINATA_GATEWAY=

# HCS fact anchoring (defaults to HEDERA_ACCOUNT_ID + HEDERA_PRIVATE_KEY)
HCS_TOPIC_ID=
HCS_OPERATOR_ACCOUNT_ID=
HCS_OPERATOR_PRIVATE_KEY=

# Render / production
HOST=0.0.0.0
